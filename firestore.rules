rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.status == "active";
    }

    function isAdmin() {
      return isActiveUser() && request.auth.token.admin == true;
    }

    function onlyAdminBackendWrites() {
      return false;
    }

    match /systems/{systemId} {
      allow read, write: if isActiveUser();
    }

    match /projects/{projectId} {
      allow read, write: if isActiveUser();
    }

    match /tasks/{taskId} {
      allow read, write: if isActiveUser();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if onlyAdminBackendWrites();
    }

    match /allowedUsers/{emailKey} {
      allow read: if isAdmin();
      allow create, update, delete: if onlyAdminBackendWrites();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if onlyAdminBackendWrites();
    }
  }
}
