rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocByUid(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return uid is string
        && uid != ""
        && exists(/databases/$(database)/documents/users/$(uid));
    }

    function isActiveUser() {
      return signedIn()
        && userExists(request.auth.uid)
        && userDoc().data.status == "active";
    }

    function isAdmin() {
      return isActiveUser() && request.auth.token.admin == true;
    }

    function activeOwner(uid) {
      return uid is string
        && uid != ""
        && (
          (signedIn() && uid == request.auth.uid)
          || (userExists(uid) && userDocByUid(uid).data.status == "active")
        );
    }

    function ownerIsAdmin(uid) {
      return activeOwner(uid) && userDocByUid(uid).data.role == "admin";
    }

    function validOwnerFields(data) {
      return data.ownerUid is string
        && activeOwner(data.ownerUid)
        && data.ownerName is string
        && ownerIds(data).hasAny([data.ownerUid]);
    }

    function ownerIds(data) {
      return data.internalOwnerIds is list && data.internalOwnerIds.size() > 0
        ? data.internalOwnerIds
        : [data.ownerUid];
    }

    function visibleListIs(data, expectedUids) {
      return data.visibleToUids is list
        && data.visibleToUids.hasAll(expectedUids)
        && data.visibleToUids.hasOnly(expectedUids);
    }

    function visibleListIsUnion(data, firstUids, secondUids) {
      return data.visibleToUids is list
        && data.visibleToUids.toSet().hasAll(firstUids)
        && data.visibleToUids.toSet().hasAll(secondUids)
        && data.visibleToUids.toSet().hasOnly(firstUids.toSet().union(secondUids.toSet()));
    }

    function visibleIds(data) {
      return data.visibleToUids is list && data.visibleToUids.size() > 0
        ? data.visibleToUids
        : ownerIds(data);
    }

    function visibleToCurrentUser() {
      return isActiveUser()
        && resource.data.visibleToUids is list
        && resource.data.visibleToUids.hasAny([request.auth.uid]);
    }

    function documentIdMatches(data, documentId) {
      return data.id is string && data.id == documentId;
    }

    function systemExists(systemId) {
      return systemId is string
        && systemId != ""
        && exists(/databases/$(database)/documents/systems/$(systemId));
    }

    function systemData(systemId) {
      return get(/databases/$(database)/documents/systems/$(systemId)).data;
    }

    function projectExists(projectId) {
      return projectId is string
        && projectId != ""
        && exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function projectExistsAfter(projectId) {
      return projectId is string
        && projectId != ""
        && existsAfter(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectAfterData(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isSystemOwner(systemId) {
      return systemExists(systemId)
        && ownerIds(systemData(systemId)).hasAny([request.auth.uid]);
    }

    function isProjectOwner(projectId) {
      return projectExists(projectId)
        && ownerIds(projectData(projectId)).hasAny([request.auth.uid]);
    }

    function isProjectOwnerAfter(projectId) {
      return projectExistsAfter(projectId)
        && ownerIds(projectAfterData(projectId)).hasAny([request.auth.uid]);
    }

    function canSeeSystem(systemId) {
      return systemExists(systemId)
        && visibleIds(systemData(systemId)).hasAny([request.auth.uid]);
    }

    function canSeeProject(projectId) {
      return projectExists(projectId)
        && visibleIds(projectData(projectId)).hasAny([request.auth.uid]);
    }

    function ownerIdentityUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && ownerIds(request.resource.data).hasAll(ownerIds(resource.data))
        && ownerIds(request.resource.data).hasOnly(ownerIds(resource.data));
    }

    function projectScopeUnchanged() {
      return request.resource.data.systemId == resource.data.systemId;
    }

    function taskScopeUnchanged() {
      return request.resource.data.scope == resource.data.scope
        && request.resource.data.systemId == resource.data.systemId
        && request.resource.data.projectId == resource.data.projectId;
    }

    function validSystem(data) {
      return validOwnerFields(data)
        && visibleListIs(data, ownerIds(data));
    }

    function validProject(data) {
      return validOwnerFields(data)
        && systemExists(data.systemId)
        && visibleListIsUnion(data, visibleIds(systemData(data.systemId)), ownerIds(data));
    }

    function validOwnProjectFields(data) {
      return data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerName is string
        && ownerIds(data).hasAny([request.auth.uid]);
    }

    function validProjectStage(data) {
      return projectExists(data.projectId)
        && data.name is string
        && visibleListIs(data, visibleIds(projectData(data.projectId)));
    }

    function validProjectStageAfter(data) {
      return projectExistsAfter(data.projectId)
        && data.name is string
        && visibleListIs(data, visibleIds(projectAfterData(data.projectId)));
    }

    function validGeneralTask(data) {
      return data.scope == "general"
        && validOwnerFields(data)
        && visibleListIs(data, ownerIds(data));
    }

    function validSystemTask(data) {
      return data.scope == "system"
        && validOwnerFields(data)
        && systemExists(data.systemId)
        && data.projectId == ""
        && visibleListIsUnion(data, visibleIds(systemData(data.systemId)), ownerIds(data));
    }

    function validProjectTask(data) {
      return data.scope == "project"
        && validOwnerFields(data)
        && projectExists(data.projectId)
        && systemExists(projectData(data.projectId).systemId)
        && data.systemId == projectData(data.projectId).systemId
        && visibleListIsUnion(data, visibleIds(projectData(data.projectId)), ownerIds(data));
    }

    function validTask(data) {
      return validGeneralTask(data)
        || validSystemTask(data)
        || validProjectTask(data);
    }

    function canCreateSystem(data) {
      return validSystem(data)
        && (ownerIds(data).hasAny([request.auth.uid]) || ownerIsAdmin(data.ownerUid));
    }

    function canUpdateSystem() {
      return ownerIds(resource.data).hasAny([request.auth.uid])
        && ownerIdentityUnchanged()
        && validSystem(request.resource.data);
    }

    function canCreateProject(data) {
      return validProject(data)
        && ownerIds(systemData(data.systemId)).hasAny([request.auth.uid]);
    }

    function canCreateOwnProject(data) {
      return validOwnProjectFields(data)
        && systemExists(data.systemId)
        && ownerIds(systemData(data.systemId)).hasAny([request.auth.uid])
        && visibleListIsUnion(data, visibleIds(systemData(data.systemId)), ownerIds(data));
    }

    function canUpdateProject() {
      return validProject(request.resource.data)
        && projectScopeUnchanged()
        && (
          isSystemOwner(resource.data.systemId)
          || (
            ownerIds(resource.data).hasAny([request.auth.uid])
            && ownerIdentityUnchanged()
          )
        );
    }

    function canCreateProjectStage(data) {
      return (
        validProjectStage(data)
        && (
          isProjectOwner(data.projectId)
          || isSystemOwner(projectData(data.projectId).systemId)
        )
      ) || (
        validProjectStageAfter(data)
        && (
          isProjectOwnerAfter(data.projectId)
          || isSystemOwner(projectAfterData(data.projectId).systemId)
        )
      );
    }

    function canUpdateProjectStage() {
      return validProjectStage(request.resource.data)
        && request.resource.data.projectId == resource.data.projectId
        && (
          isProjectOwner(resource.data.projectId)
          || isSystemOwner(projectData(resource.data.projectId).systemId)
        );
    }

    function canCreateTask(data) {
      return validTask(data)
        && (
          (data.scope == "general" && (ownerIds(data).hasAny([request.auth.uid]) || ownerIsAdmin(data.ownerUid)))
          || (data.scope == "system" && canSeeSystem(data.systemId))
          || (
            data.scope == "project"
            && canSeeProject(data.projectId)
          )
        );
    }

    function canAssignTaskInScope(data) {
      return (
        data.scope == "system"
        && isSystemOwner(data.systemId)
      ) || (
        data.scope == "project"
        && (
          isSystemOwner(projectData(data.projectId).systemId)
          || isProjectOwner(data.projectId)
        )
      );
    }

    function canUpdateTask() {
      return validTask(request.resource.data)
        && (
          (
            visibleToCurrentUser()
            && ownerIdentityUnchanged()
            && taskScopeUnchanged()
          )
          || (
            canAssignTaskInScope(resource.data)
            && canAssignTaskInScope(request.resource.data)
          )
        );
    }

    function onlyAdminBackendWrites() {
      return false;
    }

    match /systems/{systemId} {
      allow get: if isAdmin() || visibleToCurrentUser();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isActiveUser() && canCreateSystem(request.resource.data));
      allow update: if isAdmin() || (isActiveUser() && canUpdateSystem());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow get: if isAdmin() || visibleToCurrentUser();
      allow list: if isAdmin();
      allow create: if documentIdMatches(request.resource.data, projectId)
        && isActiveUser()
        && (
          request.auth.token.admin == true
          || canCreateOwnProject(request.resource.data)
          || canCreateProject(request.resource.data)
        );
      allow update: if isAdmin() || (isActiveUser() && canUpdateProject());
      allow delete: if isAdmin() || (isActiveUser() && isSystemOwner(resource.data.systemId));
    }

    match /projectStages/{stageId} {
      allow get: if isAdmin() || visibleToCurrentUser();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isActiveUser() && canCreateProjectStage(request.resource.data));
      allow update: if isAdmin() || (isActiveUser() && canUpdateProjectStage());
      allow delete: if isAdmin() || (isActiveUser() && (isProjectOwner(resource.data.projectId) || isSystemOwner(projectData(resource.data.projectId).systemId)));
    }

    match /tasks/{taskId} {
      allow get: if isAdmin() || visibleToCurrentUser();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isActiveUser() && canCreateTask(request.resource.data));
      allow update: if isAdmin() || (isActiveUser() && canUpdateTask());
      allow delete: if isAdmin() || (isActiveUser() && visibleToCurrentUser());
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if onlyAdminBackendWrites();
    }

    match /allowedUsers/{emailKey} {
      allow read: if isAdmin();
      allow create, update, delete: if onlyAdminBackendWrites();
    }

    match /accountRequests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if onlyAdminBackendWrites();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if onlyAdminBackendWrites();
    }
  }
}
